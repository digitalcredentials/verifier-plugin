{
  "name": "@digitalcredentials/verifier-plugin",
  "version": "0.0.0",
  "description": "A credential viewer and verifier for the DCC web wallet.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -b",
    "typecheck": "tsc --noEmit -p . && tsc -p tsconfig.types.json",
    "build:site": "node scripts/build-site.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint --deny-warnings",
    "test:browser": "playwright test",
    "fixtures": "node scripts/make-fixtures.js"
  },
  "devDependencies": {
    "@digitalcredentials/ed25519-signature-2020": "^6.0.0",
    "@digitalcredentials/ed25519-verification-key-2020": "^4.0.0",
    "@digitalcredentials/security-document-loader": "^6.0.0",
    "@digitalcredentials/vc": "^9.0.1",
    "@digitalcredentials/vc-bitstring-status-list": "^1.0.0",
    "@digitalcredentials/verifier-core": "github:digitalcredentials/verifier-core#d217b042371096e84b8cd0046fbe79a667683d8a",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.3.0",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^3.2.4"
  }
}
