{
  "name": "@digitalcredentials/verifier-plugin",
  "version": "0.0.0",
  "description": "A credential viewer and verifier for the DCC web wallet.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint --deny-warnings",
    "test:browser": "playwright test",
    "fixtures": "node scripts/make-fixtures.js"
  },
  "dependencies": {
    "@digitalcredentials/verifier-core": "github:threeqube/dcc-verifier-core#1ee1f487f9df8a739584e316573e750e04cbe819"
  },
  "devDependencies": {
    "@digitalcredentials/ed25519-signature-2020": "^6.0.0",
    "@digitalcredentials/ed25519-verification-key-2020": "^4.0.0",
    "@digitalcredentials/security-document-loader": "^6.0.0",
    "@digitalcredentials/vc": "^9.0.1",
    "@digitalcredentials/vc-bitstring-status-list": "^1.0.0",
    "@playwright/test": "^1.63.0",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^3.2.4"
  }
}
